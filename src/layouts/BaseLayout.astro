---
import "../styles/tokens.css";
import "../styles/typography.css";
import "../styles/layout.css";

interface Props {
  title: string;
  description?: string;
  lang?: "en" | "zh-CN";
}

const { title, description, lang = "en" } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <div class="site-frame">
      <header class="site-header">
        <nav
          class="primary-navigation type-meta"
          aria-label="Primary"
          lang="en"
        >
          <a
            class="identity-anchor"
            href="/"
            aria-current={currentPath === "/" ? "page" : undefined}
          >
            Elliott Bai
          </a>
          <span class="destination-group">
            <a
              href="/about/"
              aria-current={currentPath === "/about" ? "page" : undefined}
            >
              About
            </a>
            <a
              href="/now/"
              aria-current={currentPath === "/now" ? "page" : undefined}
            >
              Now
            </a>
          </span>
        </nav>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer type-meta">
        <a class="contact-link" href="mailto:hi@elliott.page">
          hi@elliott.page
        </a>
      </footer>
    </div>
  </body>
</html>
