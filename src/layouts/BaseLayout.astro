---
import "../styles/tokens.css";
import "../styles/typography.css";
import "../styles/layout.css";
import { primaryNavigationState } from "../lib/primary-navigation.ts";

interface Props {
  title: string;
  description?: string;
  lang?: "en" | "zh-CN";
}

const { title, description, lang = "en" } = Astro.props;
const current = primaryNavigationState(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <div class="site-frame">
      <header class="site-header">
        <nav
          class="primary-navigation type-meta"
          aria-label="Primary"
          lang="en"
        >
          <a class="identity-anchor" href="/" aria-current={current.home}>
            Elliott Bai
          </a>
          <span class="destination-group">
            <a href="/writing/" aria-current={current.writing}>Writing</a>
            <a href="/notes/" aria-current={current.notes}>Notes</a>
            <a href="/about/" aria-current={current.about}> About </a>
            <a href="/now/" aria-current={current.now}> Now </a>
          </span>
        </nav>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer type-meta">
        <a class="contact-link" href="mailto:hi@elliott.page">
          hi@elliott.page
        </a>
      </footer>
    </div>
  </body>
</html>
