---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { validateIdentityPageBody } from "../lib/identity-page-validation";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error("Required pages/about entry is missing");
}

if (about.data.draft) {
  throw new Error("Required pages/about entry must set draft: false");
}

if (!about.data.description) {
  throw new Error("Required pages/about entry must define description");
}

if (about.data.updated !== undefined) {
  throw new Error("pages/about must not define updated in v1");
}

validateIdentityPageBody("about", about.body);

const { Content } = await render(about);
---

<BaseLayout
  title={`${about.data.title} — Elliott.page`}
  description={about.data.description}
  lang={about.data.lang}
>
  <article class="type-region" aria-labelledby="about-title">
    <h1 id="about-title" class="type-title">{about.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
